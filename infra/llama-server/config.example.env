# -- llama-server (llama.cpp) configuration ------------------------------------
# Edit this file, then run start-server.bat. No GUI required.
# Build: b12246 Vulkan x64 (C:\llama\llama-server.exe)

# Path to the GGUF model. Put models in C:\llama\models\.
MODEL=C:\llama\models\YOUR_MODEL.gguf

# Name the OpenAI-compatible API exposes (clients send this as "model").
ALIAS=local

# Bind address. 127.0.0.1 = this machine only. 0.0.0.0 = LAN-accessible.
# Use 8081 when the G-Ink API owns 8080.
HOST=127.0.0.1
PORT=8081

# Total context window shared by all slots (tokens). With KV_UNIFIED=1 this is
# one pool split dynamically across PARALLEL slots.
# 4 x 64k = 262144 total (long single-window jobs; VRAM ~23.0 GB on 2x 16 GB)
# 6 x 42k = 262144 total (more concurrency; VRAM ~23.2 GB)
CTX=262144

# Number of concurrent request slots. This is the concurrency knob.
PARALLEL=4

# 1 = one shared KV pool across slots (best for mixed-length concurrent calls).
KV_UNIFIED=1

# Per-slot cap when KV_UNIFIED=1. 65536 for 4 slots; 43690 for 6 slots.
KV_UNIFIED_PER_SLOT=65536

# KV cache quantization. q4_0 measured 13.65 MiB per 1k tokens at 1 slot.
# q8_0 = higher quality, roughly double the KV VRAM. f16 = full precision.
KV_K=q4_0
KV_V=q4_0

# Minimum chunk size (tokens) to reuse from the prompt cache via KV shifting.
# 0 disables. 0 is required on this hybrid model/build.
CACHE_REUSE=0

# Flash attention: on | off | auto. Required by many Vulkan KV-quant paths.
FLASH_ATTN=on

# Dual-GPU placement. Confirm names with: llama-server --list-devices
# (this machine reports Vulkan0 and Vulkan1, both RX 9070 XT 16 GB)
DEVICES=Vulkan0,Vulkan1

# layer = split layers across GPUs (safest, best for large models)
# row   = split weights by rows (faster prompt processing, more VRAM overhead)
# none  = single GPU (use MAIN_GPU)
SPLIT_MODE=layer

# Proportion per GPU. Equal cards - 1,1.
TENSOR_SPLIT=1,1

# With split-mode=none, which GPU holds the model.
MAIN_GPU=0

# Offload every layer. Reduce if the model + KV does not fit.
GPU_LAYERS=999

# CPU threads for generation. Blank = llama.cpp auto.
THREADS=

# Batch sizes. UBATCH=1024 benchmarked best on this machine; 2048 was worse.
BATCH=2048
UBATCH=1024

# 1 = continuous batching (required for good concurrency).
CONT_BATCHING=1

# Observability endpoints: /metrics (Prometheus) and /slots.
METRICS=1
SLOTS=1

# Disable the built-in web UI for a headless server (1 = disabled).
NO_WEBUI=1

# Read/write timeout in seconds. Long generations need a generous value.
TIMEOUT=3600

# Optional bearer token. Leave blank for local-only use.
API_KEY=

# Extra raw flags appended verbatim, e.g. --no-mmap --mlock
EXTRA_ARGS=

# Print the exact command line and exit without loading a model (1 = on).
DRY_RUN=0
